{
  "name": "eact",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "pages:build": "bash scripts/build-pages.sh",
    "lint": "eslint .",
    "preview": "vite preview",
    "kinex:outbox:process": "bash -lc 'if [ -z \"$SUPABASE_PROJECT_URL\" ] || [ -z \"$SUPABASE_SERVICE_ROLE_KEY\" ]; then echo \"Missing SUPABASE_PROJECT_URL or SUPABASE_SERVICE_ROLE_KEY\"; exit 1; fi; curl -sS -X POST \"$SUPABASE_PROJECT_URL/functions/v1/process-kinex-outbox\" -H \"Authorization: Bearer $SUPABASE_SERVICE_ROLE_KEY\" -H \"Content-Type: application/json\" -d \"${KINEX_OUTBOX_PROCESS_BODY:-{\\\"batch_size\\\":10}}\"'"
  },
  "dependencies": {
    "@stripe/stripe-js": "^8.5.3",
    "@supabase/supabase-js": "^2.86.2",
    "@vercel/speed-insights": "^1.3.1",
    "lucide-react": "^0.556.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.10.1",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.22",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.7",
    "vite-plugin-pwa": "^1.2.0"
  }
}
